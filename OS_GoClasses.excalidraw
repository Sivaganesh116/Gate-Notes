    {
      "id": "AQLn8wgDftruFCBIru7kq",
      "type": "text",
      "x": 953.5568790094364,
      "y": -9833.294737990022,
      "width": 1754.4384765625,
      "height": 1075,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
