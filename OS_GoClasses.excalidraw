    {
      "id": "o5OFcHCxjdLBUwWmRHdTU",
      "type": "text",
      "x": 980.6505260030071,
      "y": -1417.597748838096,
      "width": 1414.1785888671875,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
