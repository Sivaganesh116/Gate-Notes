      "seed": 1542036216,
      "version": 129,
      "versionNonce": 1979446520,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781159819192,
      "link": null,
      "locked": false,
      "text": "Process 0:\n\nwant[0] = true;\nfavored = 1;\n\nwhile(want[1] && favored == 1);\n\n// critical section\n\nwant[0] = false;",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Process 0:\n\nwant[0] = true;\nfavored = 1;\n\nwhile(want[1] && favored == 1);\n\n// critical section\n\nwant[0] = false;",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DnupdXRLtrKnu93uHlTlJ",
      "type": "text",
      "x": 1604.1323557440828,
      "y": -430.3419225241812,
      "width": 314.7996826171875,
      "height": 250,
