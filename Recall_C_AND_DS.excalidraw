      "id": "5jLoC34EiPa4hCJae6BZv",
      "type": "text",
      "x": 1411.3923451599896,
      "y": 17730.519605115012,
      "width": 1822.2381591796875,
      "height": 2325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
