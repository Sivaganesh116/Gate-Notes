    {
      "id": "G1hrcE26Yoc6TOSOyjS9_",
      "type": "text",
      "x": 2305.1110746106942,
      "y": -4260.106261528204,
      "width": 17.139984130859375,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
