    {
      "id": "0quXM-1MgCeypAL2hWVdQ",
      "type": "text",
      "x": 1122.7167199634712,
      "y": 5313.624340008228,
      "width": 1229.5189208984375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8e",
      "roundness": null,
      "seed": 335497136,
      "version": 601,
      "versionNonce": 125162320,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781750881620,
      "link": null,
      "locked": false,
      "text": "-> These exact cases are caused at the leaf stages of a BST. \n-> But it is also possible that the insertion of a new node shall not cause the imbalance at x. Rather the imbalance will ripple\n    and reflect on much deeper nodes. In those scenarios, x and y and z can have subtrees of their own.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> These exact cases are caused at the leaf stages of a BST. \n-> But it is also possible that the insertion of a new node shall not cause the imbalance at x. Rather the imbalance will ripple\n    and reflect on much deeper nodes. In those scenarios, x and y and z can have subtrees of their own.",
      "autoResize": true,
      "lineHeight": 1.25
    },
