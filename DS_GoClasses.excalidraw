    {
      "id": "9CUDvHFZkjd3ZYIHvtKvh",
      "type": "text",
      "x": 1452.8268446553705,
      "y": 5576.630026116705,
      "width": 675.37939453125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7f",
      "roundness": null,
      "seed": 1085430148,
      "version": 276,
      "versionNonce": 48091472,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781747721387,
      "link": null,
      "locked": false,
      "text": "N(h) = N(h-1) + N(h-2) + 1\nN(h) = N(h-2) + N(h-3) + 1 + N(h-3) + N(h-4) + 1\nN(h) = N(h-2) + 2N(h-3) + N(h-4) + 2\nN(h) = N(h-3) + N(h-4) + 2(N(h-4) + N(h-5) + 1) + N(h-5) + N(h-6) + 4\nN(h) = N(h-3) + 3N(h-4) + 3N(h-5) + N(h-6) + 6\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "N(h) = N(h-1) + N(h-2) + 1\nN(h) = N(h-2) + N(h-3) + 1 + N(h-3) + N(h-4) + 1\nN(h) = N(h-2) + 2N(h-3) + N(h-4) + 2\nN(h) = N(h-3) + N(h-4) + 2(N(h-4) + N(h-5) + 1) + N(h-5) + N(h-6) + 4\nN(h) = N(h-3) + 3N(h-4) + 3N(h-5) + N(h-6) + 6\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "arVFQyQmrZgCNmhMjkVIt",
      "type": "text",
      "x": 1109.9181194407945,
      "y": 4605.270261679715,
      "width": 1056.4991455078125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7g",
      "roundness": null,
      "seed": 1337403216,
      "version": 344,
      "versionNonce": 1390049712,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781747945292,
      "link": null,
      "locked": false,
      "text": "AVL Trees:\n\n-> Balanced BST: The difference of height of left subtree and right subtree of every node E {-1, 0, 1}\n-> Search in AVL Trees is the same as any BST\n-> While we insert new nodes, we encounter 4 scenarios, where there is an imbalance caused by the new node",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AVL Trees:\n\n-> Balanced BST: The difference of height of left subtree and right subtree of every node E {-1, 0, 1}\n-> Search in AVL Trees is the same as any BST\n-> While we insert new nodes, we encounter 4 scenarios, where there is an imbalance caused by the new node",
      "autoResize": true,
      "lineHeight": 1.25
    },
